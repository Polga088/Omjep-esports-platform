PORT=3001
NODE_ENV=development

DATABASE_URL="postgresql://user:password@localhost:5432/omjep_db"

JWT_SECRET=your_jwt_secret_here
JWT_EXPIRES_IN=7d

# EA FC 26 / Pro Clubs sync (no EA login; optional HTTP bridge).
# When false: disables scheduled ProClubs.io HTTP (SyncService 5m cron, EaStatsService 2h cron),
# ProClubs scraping, and EA match sync provider — beta stays quiet in PM2 logs.
EA_CLUBS_SYNC_ENABLED=false
# Optional: URL template with {eaClubId} and {platform} placeholders returning JSON { "matches": [...] }
# EA_CLUBS_RECENT_MATCHES_URL=
# EA_CLUBS_HTTP_TIMEOUT_MS=15000
